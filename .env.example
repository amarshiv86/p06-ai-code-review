# GitHub — create a Personal Access Token with repo + pull-requests scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret — set this in your GitHub repo webhook settings
WEBHOOK_SECRET=your_webhook_secret_here

# HuggingFace — reuse your existing HF token (free account, no billing needed)
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model to use for reviews (free tier, no credit card required)
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Max characters of diff to send to the model (keep under 12000 for Mistral 7B)
MAX_DIFF_CHARS=12000
